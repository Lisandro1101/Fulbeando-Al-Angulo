{
  "firestore": {
    "rules": "app/firestore.rules",
    "indexes": "AL ANGULO/firebase/firestore.indexes.json"
  },
  "database": {
    "rules": "AL ANGULO/firebase/database.rules.json"
  },
  "functions": {
    "source": "AL ANGULO/firebase/functions",
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" install",
      "npm --prefix \"$RESOURCE_DIR\" run build"
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "database": {
      "port": 9000
    },
    "functions": {
      "port": 5001
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
