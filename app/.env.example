# Copiá este archivo a .env.local y completá con los datos de tu proyecto Firebase.
# Los emuladores locales evitan tocar datos reales durante el desarrollo.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# true = conecta a los emuladores (firebase emulators:start)
VITE_USE_EMULATORS=false

# Radio del radar "Falta 1" en km
VITE_RADAR_RADIO_KM=5