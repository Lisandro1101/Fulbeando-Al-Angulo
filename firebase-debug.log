[debug] [2026-10-06T03:54:29.652Z] >>> [apiv2][body] PUT http://127.0.0.1:9000/.settings/rules.json "{\n  \"rules\": {\n    \"match_chats\": {\n      \"$matchId\": {\n        // LECTURA: Solo pueden leer los capitanes involucrados (inscriptos en metadata)\n        \".read\": \"auth != null && data.child('meta/participants/' + auth.uid).val() == true\",\n        \n        // ESCRITURA: Solo capitanes y únicamente si el estado de la sala sigue \"OPEN\"\n        \".write\": \"auth != null && data.child('meta/participants/' + auth.uid).val() == true && data.child('meta/status').val() == 'OPEN'\",\n        \n        \"meta\": {\n           // Los metadatos (quién participa, estado) solo los crea/modifica el backend, no el cliente.\n           \".write\": \"false\" \n        },\n\n        \"messages\": {\n           \"$messageId\": {\n             // REGLAS ESTRICTAS DE VALIDACIÓN:\n             // 1. !data.exists(): Prohíbe sobreescribir/modificar mensajes pasados (Idempotencia)\n             // 2. senderId debe ser idéntico al usuario autenticado (Previene Spoofing)\n             // 3. El texto es obligatorio, string, y tiene un CAP MÁXIMO de 500 caracteres para cuidar la base.\n             \".validate\": \"!data.exists() && newData.hasChildren(['senderId', 'senderName', 'text', 'timestamp']) && newData.child('senderId').val() == auth.uid && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 500 && newData.child('timestamp').isNumber()\"\n           }\n        }\n      }\n    }\n  }\n}\n"
