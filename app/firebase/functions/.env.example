# Credenciales de Cloudflare R2 para Firebase Functions
# Copia este archivo a .env o .env.local dentro de app/firebase/functions/

# ID de cuenta de Cloudflare (se encuentra en Cloudflare Dashboard -> R2 -> Account Details)
R2_ACCOUNT_ID=tu_account_id

# Token de acceso R2 (Cloudflare Dashboard -> R2 -> Manage R2 API Tokens)
R2_ACCESS_KEY_ID=tu_access_key_id
R2_SECRET_ACCESS_KEY=tu_secret_access_key

# Nombre del bucket en Cloudflare R2
R2_BUCKET_NAME=fulbeando-media

# Dominio público configurado en Cloudflare (URL pública .r2.dev)
R2_PUBLIC_URL_PREFIX=https://pub-2c1810718d6f428baa142d9c12bac0c5.r2.dev

