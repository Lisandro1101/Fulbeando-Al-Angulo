# Copiá este archivo a .env.local y completá con los datos de tu proyecto Firebase.
# Los emuladores locales evitan tocar datos reales durante el desarrollo.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# true = conecta a los emuladores (firebase emulators:start)
VITE_USE_EMULATORS=false

# Radio del radar "Falta 1" en km
VITE_RADAR_RADIO_KM=5

# true = el radar se sirve con la Cloud Function `radarQuery` (Fase 2) en vez de
# las consultas directas. Requiere la Function desplegada (o el emulador de
# Functions corriendo). Si falla, el cliente cae solo a las consultas directas.
VITE_RADAR_USA_FUNCTION=false

# true = sube assets multimedia (avatares, escudos, fotos) a Cloudflare R2 vía Cloudflare Worker
# Si es false o falla, cae automáticamente en Firebase Storage como respaldo
VITE_USE_R2=true
VITE_CLOUDFLARE_WORKER_URL=https://fulbeando-uploader.tu-usuario.workers.dev