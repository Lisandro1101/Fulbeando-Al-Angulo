[debug] [2026-10-03T20:07:19.517Z] >>> [apiv2][query] PUT http://127.0.0.1:8080/emulator/v1/projects/demo-no-project:securityRules [none]
[debug] [2026-10-03T20:07:19.518Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/demo-no-project:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\n\n/**\n * Fulbeando - reglas de Firestore.\n *\n * Decisiones que vienen del PRD y no se negocian:\n * - El comprobante NO es legible por el publico: vive en `comprobantes/{turnoId}`\n *   y el turno solo expone `comprobantePendiente`.\n * - No existe borrado fisico: `delete` esta prohibido en todas las colecciones\n *   de negocio; la baja es logica (`deletedAt` / `estado: 'inactivo'`).\n * - Los turnos se crean solo desde la grilla que carga el dueno del predio, por\n *   lo que un jugador jamas puede inventar una franja.\n * - La pertenencia a un predio se resuelve leyendo `predios/{id}.duenoUid`.\n */\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    function miUid() {\n      return request.auth.uid;\n    }\n\n    function existeUsuario() {\n      return request.auth != null\n        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));\n    }\n\n    function miDoc() {\n      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;\n    }\n\n    function esSuperadmin() {\n      return existeUsuario() && miDoc().rol == 'superadmin';\n    }\n\n    /** Dueno del predio indicado (o superadmin). */\n    function esDuenoDe(predioId) {\n      return request.auth != null\n        && (\n          esSuperadmin()\n          || (\n            exists(/databases/$(database)/documents/predios/$(predioId))\n            && get(/databases/$(database)/documents/predios/$(predioId)).data.duenoUid == request.auth.uid\n          )\n        );\n    }\n\n    function esPredioRecursoPublico() {\n      return resource.data.verificado == true\n        && resource.data.estado == 'activo';\n    }\n\n    function esPredioDocPublico(predioId) {\n      return exists(/databases/$(database)/documents/predios/$(predioId))\n        && get(/databases/$(database)/documents/predios/$(predioId)).data.verificado == true\n        && get(/databases/$(database)/documents/predios/$(predioId)).data.estado == 'activo'\n        && get(/databases/$(database)/documents/predios/$(predioId)).data.deletedAt == null;\n    }\n\n    // ------------------------------------------------------------------ //\n    // Usuarios                                                          //\n    // ------------------------------------------------------------------ //\n    match /usuarios/{uid} {\n      allow read: if request.auth != null;\n\n      // Creacion propia desde Auth: rol jugador, sin baja, sin vertices.\n      allow create: if miUid() == uid\n        && request.resource.data.rol == 'jugador'\n        && request.resource.data.estado == 'activo'\n        && request.resource.data.deletedAt == null;\n\n      // Rol y estado los resuelve el superadmin. El usuario no puede auto-cambiarse el rol.\n      allow update: if request.auth != null\n        && (\n          request.auth.uid != uid\n          || (\n            request.resource.data.rol == resource.data.rol\n            && request.resource.data.estado == resource.data.estado\n            && request.resource.data.deletedAt == resource.data.deletedAt\n          )\n        );\n\n      allow delete: if false;\n    }\n\n    // ------------------------------------------------------------------ //\n    // Solicitudes de dueno (autodesdeclaracion con verificacion)         //\n    // ------------------------------------------------------------------ //\n    match /solicitudes/{uid} {\n      allow read: if request.auth != null;\n\n      allow create: if miUid() == uid\n        && request.resource.data.uid == uid\n        && request.resource.data.estado == 'pendiente'\n        && request.resource.data.revisadoPor == null\n        && request.resource.data.motivoRechazo == null;\n\n      // El usuario solo puede corregir o reenviar su solicitud: jamas decidirla.\n      allow update: if esSuperadmin()\n        || (\n          miUid() == uid\n          && request.resource.data.estado == 'pendiente'\n          && resource.data.estado != 'aprobada'\n        );\n\n      allow delete: if false;\n    }\n\n    // ------------------------------------------------------------------ //\n    // Predios y canchas                                                  //\n    // ------------------------------------------------------------------ //\n    match /predios/{predioId} {\n      allow read: if true;\n\n      allow create: if request.auth != null\n        && request.resource.data.duenoUid == request.auth.uid\n        && request.resource.data.verificado == false\n        && request.resource.data.estado == 'activo'\n        && request.resource.data.deletedAt == null;\n\n      // El dueno edita su predio pero no puede auto-verificarse ni auto-reactivar.\n      allow update: if esSuperadmin()\n        || (existeUsuario()\n          && miDoc().rol == 'dueno_predio'\n          && resource.data.duenoUid == request.auth.uid\n          && request.resource.data.verificado == resource.data.verificado\n          && request.resource.data.duenoUid == resource.data.duenoUid);\n\n      allow delete: if false;\n\n      match /canchas/{canchaId} {\n        allow read: if true;\n\n        allow create, update: if esDuenoDe(predioId)\n          && request.resource.data.predioId == predioId;\n\n        allow delete: if false;\n      }\n    }\n\n    // ------------------------------------------------------------------ //\n    // Turnos                                                            //\n    // ------------------------------------------------------------------ //\n    match /turnos/{turnoId} {\n      // Disponibilidad: lectura publica, sin datos de comprobante ni de organizador\n      // fuera de lo indispensable para el flujo.\n      allow get, list: if true;\n\n      // Alta de grilla: solo el dueno del predio, siempre en `disponible`.\n      allow create: if esDuenoDe(request.resource.data.predioId)\n        && request.resource.data.estado == 'disponible'\n        && request.resource.data.deletedAt == null;\n\n      // Regla 6.1: reclamar un turno libre pasa a `bloqueado_temporal` con el\n      // bloqueo de 15 min y el comprobante pendiente. Ojo: el permiso se evalua\n      // sobre el documento ANTERIOR, donde `organizadorUid` todavia es null,\n      // por eso se valida que el NUEVO doc se apropie del turno.\n      allow update: if esDuenoDe(resource.data.predioId)\n        || (\n          request.auth != null\n          && (\n            (\n              resource.data.estado == 'disponible'\n              && resource.data.organizadorUid == null\n              && request.resource.data.organizadorUid == request.auth.uid\n              && request.resource.data.estado == 'bloqueado_temporal'\n              && request.resource.data.bloqueadoHasta != null\n              && request.resource.data.comprobantePendiente == true\n            )\n            || (\n              resource.data.estado == 'confirmado'\n              && resource.data.organizadorUid == request.auth.uid\n              && request.resource.data.estado == 'cancelado'\n            )\n            // El organizador libera su propia solicitud antes de la validacion.\n            || (\n              resource.data.estado == 'bloqueado_temporal'\n              && resource.data.organizadorUid == request.auth.uid\n              && request.resource.data.estado == 'cancelado'\n            )\n          )\n        );\n\n      allow delete: if false;\n    }\n\n    // ------------------------------------------------------------------ //\n    // Comprobantes: organizador del turno, dueno del predio y superadmin //\n    // ------------------------------------------------------------------ //\n    match /comprobantes/{turnoId} {\n      function turnoDelDocumento() {\n        return get(/databases/$(database)/documents/turnos/$(turnoId)).data;\n      }\n\n      allow read: if esSuperadmin()\n        || (request.auth != null && resource.data.organizerUid == request.auth.uid)\n        || esDuenoDe(turnoDelDocumento().predioId);\n\n      // Se escribe en la misma transaccion que el turno, asi que NO puede validar\n      // el turno: las rules leen el estado previo (organizadorUid == null).\n      // El resguardo real es que el turno solo queda reservado si su update pasa.\n      allow create: if request.auth != null\n        && request.resource.data.turnoId == turnoId\n        && request.resource.data.organizerUid == request.auth.uid\n        && request.resource.data.verificado == false\n        && request.resource.data.revisadoPor == null\n        && exists(/databases/$(database)/documents/turnos/$(turnoId));\n\n      allow update: if esDuenoDe(turnoDelDocumento().predioId);\n\n      allow delete: if false;\n    }\n\n    // ------------------------------------------------------------------ //\n    // Alertas \"Falta 1\" y postulaciones                                 //\n    // ------------------------------------------------------------------ //\n    match /alertas/{alertaId} {\n      // En `create` el turno todavia no esta en `resource`: se resuelve con el\n      // turnoId que trae la propia peticion.\n      function turnoDeAlerta() {\n        return get(/databases/$(database)/documents/turnos/$(request.resource.data.turnoId)).data;\n      }\n\n      allow read: if request.auth != null;\n\n      // Regla 6.2: solo el organizador con turno confirmado o el dueno del predio.\n      allow create: if request.auth != null\n        && request.resource.data.creadoPorUid == request.auth.uid\n        && request.resource.data.estado == 'activa'\n        && request.resource.data.confirmados == 0\n        && (\n          turnoDeAlerta().estado == 'confirmado'\n            && (\n              turnoDeAlerta().organizadorUid == request.auth.uid\n              || esDuenoDe(request.resource.data.predioId)\n            )\n        );\n\n      // El creador confirma postulantes; los parametros del partido son inmutables.\n      // El geo se compara campo por campo: `==` no funciona con mapas en rules,\n      // y una comparacion de mapas denies la escritura siempre.\n      allow update: if esSuperadmin()\n        || (\n          request.auth != null\n          && resource.data.creadoPorUid == request.auth.uid\n          && request.resource.data.confirmados >= resource.data.confirmados\n          && request.resource.data.turnoId == resource.data.turnoId\n          && request.resource.data.fecha == resource.data.fecha\n          && request.resource.data.horaInicio == resource.data.horaInicio\n          && request.resource.data.cantidadRequeridos == resource.data.cantidadRequeridos\n          && request.resource.data.geo.prefijo == resource.data.geo.prefijo\n          && request.resource.data.geo.lat == resource.data.geo.lat\n          && request.resource.data.geo.lng == resource.data.geo.lng\n        );\n\n      allow delete: if false;\n\n      match /postulaciones/{uid} {\n        allow read: if request.auth != null;\n\n        allow create: if miUid() == uid\n          && request.resource.data.uid == uid\n          && request.resource.data.estado == 'postulado';\n\n        // El jugador se retira o vuelve a postularse; confirmar lo hace el\n        // creador del radar. Un suplente ya confirmado no puede degradarse a\n        // \"postulado\" para inflar el contador.\n        allow update: if esSuperadmin()\n          || (\n            miUid() == uid\n            && resource.data.uid == uid\n            && resource.data.estado != 'confirmado'\n            && (\n              request.resource.data.estado == 'retirado'\n              || request.resource.data.estado == 'postulado'\n            )\n            && request.resource.data.uid == resource.data.uid\n            && request.resource.data.nombre == resource.data.nombre\n          )\n          || (\n            request.auth != null\n            && get(/databases/$(database)/documents/alertas/$(alertaId)).data.creadoPorUid == request.auth.uid\n            && request.resource.data.uid == resource.data.uid\n          );\n\n        allow delete: if false;\n      }\n    }\n\n    // ------------------------------------------------------------------ //\n    // Reportes (moderacion del superadmin)                              //\n    // ------------------------------------------------------------------ //\n    match /reportes/{reporteId} {\n      allow create: if request.auth != null\n        && request.resource.data.reportanteUid == request.auth.uid\n        && request.resource.data.estado == 'abierto'\n        && request.resource.data.resueltoPor == null;\n\n      allow read: if esSuperadmin()\n        || (request.auth != null && resource.data.reportanteUid == request.auth.uid);\n\n      allow update: if esSuperadmin();\n\n      allow delete: if false;\n    }\n\n    // ================================================================== //\n    // INTEGRACIÓN \"AL ÁNGULO\" (Módulos Sociales y Gamificación)\n    // ================================================================== //\n    \n    // Función auxiliar anti-inyección de la rama social\n    function isPayloadSizeValid() {\n      return request.resource.size < 10000; \n    }\n\n    // TEAMS (Equipos del Radar)\n    match /teams/{teamId} {\n      allow read: if request.auth != null;\n      allow create: if request.auth != null \n                    && isPayloadSizeValid()\n                    && request.resource.data.captainId == request.auth.uid\n                    && request.resource.data.members.size() >= 1 // Empieza con el capitan\n                    && request.resource.data.members.size() <= 22;\n      allow update: if request.auth != null \n                    && resource.data.captainId == request.auth.uid\n                    && request.resource.data.captainId == resource.data.captainId\n                    && request.resource.data.members.size() >= 1\n                    && request.resource.data.members.size() <= 22;\n      allow delete: if false; \n    }\n\n    // CHALLENGES (Desafíos entre equipos)\n    match /challenges/{challengeId} {\n      allow read: if request.auth != null;\n      allow create: if request.auth != null && isPayloadSizeValid() && request.resource.data.creatorId == request.auth.uid;\n      allow update: if request.auth != null && resource.data.creatorId == request.auth.uid;\n      allow delete: if request.auth != null && resource.data.creatorId == request.auth.uid;\n    }\n\n    // MATCHES (Partidos de Gamificación)\n    match /matches/{matchId} {\n      allow read: if request.auth != null;\n      allow create: if request.auth != null && isPayloadSizeValid() \n                    && (request.resource.data.localCaptainId == request.auth.uid || request.resource.data.visitorCaptainId == request.auth.uid);\n      allow update: if request.auth != null \n                    && (resource.data.localCaptainId == request.auth.uid || resource.data.visitorCaptainId == request.auth.uid)\n                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['playerStats', 'matchConfirmedAt']); \n      allow delete: if false;\n    }\n\n    // REVIEWS (Reputación B2B / Jugadores)\n    match /reviews/{reviewId} {\n      allow read: if request.auth != null;\n      allow create: if request.auth != null\n                    && isPayloadSizeValid()\n                    && request.resource.data.reviewerUserId == request.auth.uid\n                    && reviewId == request.resource.data.matchId + '_' + request.auth.uid\n                    && get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data.status == 'confirmed';\n      allow update, delete: if false; \n    }\n\n    // SYSTEM METRICS (Dashboard SuperAdmin)\n    match /system_metrics/{docId} {\n      allow read, write: if esSuperadmin();\n    }\n  }\n}"}]}}
