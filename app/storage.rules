rules_version = '2';

/**
 * Fulbeando - reglas de Storage.
 * Solo se suben imagenes de comprobante de transferencia (regla 6.5).
 * Se leen el organizador que subio el archivo, el dueno del predio del turno
 * y el superadmin. Cualquier otra imagen del bucket queda prohibida.
 */
service firebase.storage {
  match /b/{bucket}/o {

    function esSuperadmin() {
      return request.auth != null
        && (
          request.auth.token.email in ['lisandrodileva@gmail.com', 'superadmin@fulbeando.com']
          || firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.rol == 'superadmin'
        );
    }

    function turnoDelTurnoId(turnoId) {
      return firestore.get(/databases/(default)/documents/turnos/$(turnoId)).data;
    }

    /** El turno queda embebido en el path: comprobantes/{uid}/{turnoId}/{archivo} */
    match /comprobantes/{uid}/{turnoId}/{archivo} {
      allow read: if esSuperadmin()
        || request.auth.uid == uid
        || (request.auth != null
          && firestore.get(/databases/(default)/documents/predios/$(turnoDelTurnoId(turnoId).predioId)).data.duenoUid == request.auth.uid);

      // Solo imagenes o PDF (ej: Mercado Pago), hasta 5 MB, y solo a su propio espacio de nombres.
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');

      allow delete: if false;
    }

    // ------------------------------------------------------------------ //
    // Avatar y escudo: imagenes NO sensibles que la app pinta en tarjetas. //
    // Se leen con `<img src>` desde fuera de la app (sin cabecera de auth), //
    // por eso la lectura queda abierta: el acceso efectivo depende del      //
    // `token` que devuelve `getDownloadURL`. Lo sensible (comprobantes)     //
    // sigue cerrado en su propio match.                                    //
    // ------------------------------------------------------------------ //

    /** Foto de perfil: cada quien escribe SOLO en su propio espacio. */
    match /avatars/{uid}/{archivo} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if false;
    }

    /**
     * Escudo del equipo: `teams/{teamId}/{archivo}`.
     * La condicion de escritura es la misma que el update de `teams/{id}` en
     * `firestore.rules`: solo el capitan. Por eso el caller tiene que pasar
     * `folder = teams/${teamId}` y no `teams` a secas.
     */
    match /teams/{teamId}/{archivo} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && firestore.get(/databases/(default)/documents/teams/$(teamId)).data.captainId
             == request.auth.uid;
      allow delete: if false;
    }

    /**
     * Fotos del muro social: `posts/{uid}/{archivo}`.
     * El caller pasa `folder = posts/${uid}`. Igual que avatares, la lectura
     * queda abierta (el feed pinta las fotos con `<img src>`); la escritura solo
     * en el propio espacio. El MVP no admite video: solo imagenes.
     */
    match /posts/{uid}/{archivo} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if false;
    }

    // Cualquier otra ruta del bucket queda prohibida.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}