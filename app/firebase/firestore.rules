rules_version = '2';

/**
 * Fulbeando - reglas de Firestore.
 *
 * Decisiones que vienen del PRD y no se negocian:
 * - El comprobante NO es legible por el publico: vive en `comprobantes/{turnoId}`
 *   y el turno solo expone `comprobantePendiente`.
 * - No existe borrado fisico: `delete` esta prohibido en todas las colecciones
 *   de negocio; la baja logica (`deletedAt` / `estado: 'inactivo'`).
 * - Los turnos se crean solo desde la grilla que carga el dueno del predio.
 * - La pertenencia a un predio se resuelve leyendo `predios/{id}.duenoId`.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    // ================================================================== //
    // Helpers de Autenticacion y Roles                                   //
    // ================================================================== //
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function isSuperadmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && getUserData().rol == 'superadmin';
    }

    /** Dueno del predio indicado (o superadmin). */
    function esDuenoDe(predioId) {
      return isSignedIn()
        && (
          isSuperadmin()
          || (
            exists(/databases/$(database)/documents/predios/$(predioId))
            && get(/databases/$(database)/documents/predios/$(predioId)).data.duenoUid == request.auth.uid
          )
        );
    }

    // ------------------------------------------------------------------ //
    // Helpers de Equipos ("AL ANGULO")                                   //
    // ------------------------------------------------------------------ //

    function getTeam(teamId) {
      return get(/databases/$(database)/documents/teams/$(teamId));
    }

    /**
     * El update agrega exclusivamente el propio uid como miembro `PLAYER` y no
     * altera ningun otro miembro.
     *
     * NO se usa `List.where()` porque no existe en el lenguaje de reglas. La
     * comparacion es de conjuntos: el nuevo plantel debe ser exactamente el
     * anterior mas la entrada propia. Exigir igualdad exacta (y no solo "agregar
     * el propio uid") impide que de paso borre o modifique a otro jugador.
     *
     * El nombre se exige igual al del documento del usuario: asi un cliente
     * manipulado no puede meter un nombre arbitrario en el plantel ajeno.
     */
    function soloAnadePropioMiembro(teamId, uid) {
      return exists(/databases/$(database)/documents/teams/$(teamId))
        && exists(/databases/$(database)/documents/usuarios/$(uid))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && request.resource.data.members.size() == resource.data.members.size() + 1
        && request.resource.data.members.toSet() == resource.data.members.toSet().union(
             [{
               'uid': uid,
               'name': getUserData().nombre + ' ' + getUserData().apellido,
               'role': 'PLAYER'
             }].toSet()
           );
    }

    // ------------------------------------------------------------------ //
    // Usuarios                                                          //
    // ------------------------------------------------------------------ //
    match /usuarios/{uid} {
      allow read: if isSignedIn();

      // Creacion propia desde Auth: rol jugador o invitado.
      allow create: if isSignedIn() && request.auth.uid == uid
        && (request.resource.data.rol == 'jugador' || request.resource.data.rol == 'invitado')
        && request.resource.data.estado == 'activo'
        && request.resource.data.deletedAt == null;

      // El usuario puede alterar su propio rol solo si es 'invitado'.
      allow update: if isSignedIn()
        && (
          isSuperadmin()
          || (
            request.auth.uid == uid
            && (
              request.resource.data.rol == resource.data.rol
              || (resource.data.rol == 'invitado' && (request.resource.data.rol == 'jugador' || request.resource.data.rol == 'dueno_predio'))
            )
            && request.resource.data.estado == resource.data.estado
            && request.resource.data.deletedAt == resource.data.deletedAt
            // Regla de negocio: un jugador puede estar en como mucho 2 equipos a
            // la vez (contando el propio que creo).
            //
            // Se valida ACIA porque `perfilDeportivo.teamIds` lo escribe el
            // cliente: `teamService` avisa antes, pero un cliente modificado se
            // saltaria ese chequeo. El limite tiene quevivir en el servidor.
            //
            // Acceder a una clave ausente es error de evaluacion, asi que se
            // consulta con `keys().hasAny([...])` antes de `.size()`.
            && (
              !request.resource.data.keys().hasAny(['perfilDeportivo'])
              || request.resource.data.perfilDeportivo == null || !request.resource.data.perfilDeportivo.keys().hasAny(['teamIds'])
              || (
                (request.resource.data.perfilDeportivo.teamIds is list)
                && request.resource.data.perfilDeportivo.teamIds.size() <= 2
              )
            )
          )
        );

      allow delete: if false;
    }

    // ------------------------------------------------------------------ //
    // Solicitudes de dueno (autodesdeclaracion con verificacion)         //
    // ------------------------------------------------------------------ //
    match /solicitudes/{uid} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.revisadoPor == null
        && request.resource.data.motivoRechazo == null;

      // Solo el superadmin puede aprobar. El usuario solo actualiza si esta pendiente.
      allow update: if isSuperadmin()
        || (
          request.auth.uid == uid
          && request.resource.data.estado == 'pendiente'
          && resource.data.estado != 'aprobada'
        );

      allow delete: if false;
    }

    // ------------------------------------------------------------------ //
    // Predios y canchas                                                  //
    // ------------------------------------------------------------------ //
    match /predios/{predioId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.duenoUid == request.auth.uid
        && request.resource.data.verificado == false
        && request.resource.data.estado == 'activo'
        && request.resource.data.deletedAt == null;

      allow update: if isSuperadmin()
        || (isSignedIn()
          && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
          && getUserData().rol == 'dueno_predio'
          && resource.data.duenoUid == request.auth.uid
          && request.resource.data.verificado == resource.data.verificado
          && request.resource.data.duenoUid == resource.data.duenoUid);

      allow delete: if false;

      match /canchas/{canchaId} {
        allow read: if true;
        allow create, update: if esDuenoDe(predioId)
          && request.resource.data.predioId == predioId;
        allow delete: if false;
      }
    }

    // ------------------------------------------------------------------ //
    // Turnos                                                            //
    // ------------------------------------------------------------------ //
    match /turnos/{turnoId} {
      allow get, list: if true;

      // Alta de grilla: solo el dueno del predio, siempre en `disponible`.
      allow create: if esDuenoDe(request.resource.data.predioId)
        && request.resource.data.estado == 'disponible'
        && request.resource.data.deletedAt == null;

      allow update: if esDuenoDe(resource.data.predioId)
        || (
          isSignedIn()
          && (
            // Reservar (jugador).
            // `organizadorUid` es el nombre canonico en `Turno`. Las rules
            // pedian antes `jugadorId`, campo que el cliente nunca escribe:
            // toda reserva caia en PERMISSION_DENIED.
            (
              resource.data.estado == 'disponible'
              && resource.data.organizadorUid == null
              && request.resource.data.organizadorUid == request.auth.uid
              && request.resource.data.estado == 'bloqueado_temporal'
              && request.resource.data.bloqueadoHasta != null
              && request.resource.data.comprobantePendiente == true
            )
            // Cancelar propia reserva confirmada (jugador)
            || (
              resource.data.estado == 'confirmado'
              && resource.data.organizadorUid == request.auth.uid
              && request.resource.data.estado == 'cancelado'
            )
            || (
              resource.data.estado == 'bloqueado_temporal'
              && resource.data.organizadorUid == request.auth.uid
              && request.resource.data.estado == 'cancelado'
            )
          )
        );

      allow delete: if false;
    }

    // ------------------------------------------------------------------ //
    // Comprobantes                                                       //
    // ------------------------------------------------------------------ //
match /comprobantes/{turnoId} {
      function turnoDelDocumento() {
        return get(/databases/$(database)/documents/turnos/$(turnoId)).data;
      }

/**
       * El comprobante solo puede colgar de un turno PROPIO.
       *
       * Antes la regla se limitaba a `exists(turnos/$(turnoId))`, asi que
       * cualquiera podia subir un comprobante sobre la reserva de otro y el
       * dueno veia una imagen ajena.
       *
       * Usa `getAfter()` y no `get()`. No es una preferencia: `reservarTurno`
       * escribe el turno y el comprobante en la MISMA transaccion, y dentro de
       * una transaccion `get()` sigue viendo el estado previo al commit (el
       * turno todavia tiene `organizadorUid == null`), con lo cual toda reserva
       * online caia en PERMISSION_DENIED. Verificado con el test
       * "reserva y comprobante en una sola transaccion", que ademas cubre el
       * orden inverso de escrituras.
       *
       * `getAfter` degrada bien: en un `set` suelto del comprobante (sin
       * escritura de turno en la misma peticion) devuelve el estado actual del
       * turno, o sea que la regla sigue siendo estricta.
       */
      function turnoEsPropio(uid) {
        let d = getAfter(/databases/$(database)/documents/turnos/$(turnoId)).data;
        return d != null && d.organizadorUid == uid;
      }

      allow read: if isSuperadmin()
        || (isSignedIn() && resource.data.organizadorUid == request.auth.uid)
        || esDuenoDe(turnoDelDocumento().predioId);

      allow create: if isSignedIn()
        && request.resource.data.turnoId == turnoId
        && request.resource.data.organizadorUid == request.auth.uid
        && request.resource.data.verificado == false
        && request.resource.data.revisadoPor == null
        && turnoEsPropio(request.auth.uid);

      allow update: if esDuenoDe(turnoDelDocumento().predioId) || isSuperadmin();

      allow delete: if false;
    }

    // ------------------------------------------------------------------ //
    // Alertas "Falta 1" y postulaciones                                 //
    // ------------------------------------------------------------------ //
    match /alertas/{alertaId} {
      /**
       * El turno del que cuelga la alerta. Devuelve `null` si el turno no
       * existe: el acceso directo a `.data.estado` de un `get()` inexistente
       * revienta con error de evaluacion en vez de dar `false`, y eso se
       * reporta como un `PERMISSION_DENIED` imposible de depurar.
       */
      function turnoDeAlerta() {
        let p = /databases/$(database)/documents/turnos/$(request.resource.data.turnoId);
        return exists(p) ? get(p).data : null;
      }

      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.creadoPorUid == request.auth.uid
        && request.resource.data.estado == 'activa'
        && request.resource.data.confirmados == 0
        && turnoDeAlerta() != null
        && turnoDeAlerta().estado == 'confirmado'
        && (
          turnoDeAlerta().organizadorUid == request.auth.uid
          || esDuenoDe(request.resource.data.predioId)
        );

      allow update: if isSuperadmin()
        || (
          isSignedIn()
          && resource.data.creadoPorUid == request.auth.uid
          && request.resource.data.confirmados >= resource.data.confirmados
          && request.resource.data.turnoId == resource.data.turnoId
          && request.resource.data.fecha == resource.data.fecha
          && request.resource.data.horaInicio == resource.data.horaInicio
          && request.resource.data.cantidadRequeridos == resource.data.cantidadRequeridos
          && request.resource.data.geo.prefijo == resource.data.geo.prefijo
          && request.resource.data.geo.lat == resource.data.geo.lat
          && request.resource.data.geo.lng == resource.data.geo.lng
        );

      allow delete: if false;

      match /postulaciones/{uid} {
        allow read: if isSignedIn();

        allow create: if isSignedIn() && request.auth.uid == uid
          && request.resource.data.uid == uid
          && request.resource.data.estado == 'postulado';

        allow update: if isSuperadmin()
          || (
            isSignedIn() && request.auth.uid == uid
            && resource.data.uid == uid
            && resource.data.estado != 'confirmado'
            && (
              request.resource.data.estado == 'retirado'
              || request.resource.data.estado == 'postulado'
            )
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.nombre == resource.data.nombre
          )
          || (
            isSignedIn()
            && get(/databases/$(database)/documents/alertas/$(alertaId)).data.creadoPorUid == request.auth.uid
            && request.resource.data.uid == resource.data.uid
          );

        allow delete: if false;
      }
    }

    // ------------------------------------------------------------------ //
    // Reportes (moderacion del superadmin)                              //
    // ------------------------------------------------------------------ //
    match /reportes/{reporteId} {
      allow create: if isSignedIn()
        && request.resource.data.reportanteUid == request.auth.uid
        && request.resource.data.estado == 'abierto'
        && request.resource.data.resueltoPor == null;

      allow read: if isSuperadmin()
        || (isSignedIn() && resource.data.reportanteUid == request.auth.uid);

      allow update: if isSuperadmin();

      allow delete: if false;
    }

    // ================================================================== //
    // INTEGRACIÃ“N "AL ÃNGULO" (MÃ³dulos Sociales y GamificaciÃ³n)
    // ================================================================== //
    
    /**
     * Un texto opcional debe, si existe, ser string y estar acotado.
     *
     * Importante: en las reglas, ACCEDER a una clave inexistente es un error de
     * evaluacion (no un `false`), y un error de evaluacion deniega la escritura.
     * Por eso cada campo se consulta con `keys().hasAny([...])` antes de tocarlo.
     */
    function textoOpcionalSano(data, campo, max) {
      return !data.keys().hasAny([campo])
        || !(data.get(campo, '') is string)
        || data.get(campo, '').size() <= max;
    }

    function isPayloadSizeValid() {
      return textoOpcionalSano(request.resource.data, 'name', 60)
        && textoOpcionalSano(request.resource.data, 'description', 500)
        && textoOpcionalSano(request.resource.data, 'descripcion', 500)
        && textoOpcionalSano(request.resource.data, 'comment', 500)
        && (!(request.resource.data.keys().hasAny(['members'])
             && request.resource.data.members is list)
             || request.resource.data.members.size() <= 23);
    }

    match /teams/{teamId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
                    && isPayloadSizeValid()
                    && request.resource.data.captainId == request.auth.uid
                    && request.resource.data.members.size() >= 1
                    && request.resource.data.members.size() <= 23;

      // Dos vias legitimas de escritura:
      //  1) El capitan gestiona el plantel (alta, baja, dorsal, capitania).
      //  2) Un jugador se agrega a si mismo (autoinscripcion), porque las reglas de
      //     `usuarios/{uid}` no permiten que el capitan escriba el perfil de otro.
      //     En la autoinscripcion solo se anade el propio uid: no se puede tocar el
      //     resto del plantel ni cambiar la capitania.
      //
      // El DT tambien puede gestionar el plantel, pero comprobarlo exigiria
      // recorrer `members` y el lenguaje de reglas no tiene `List.where()` ni
      // funciones recursivas. Se deja para cuando exista la UI de DT.
      allow update: if isSignedIn()
                    && (
                      resource.data.captainId == request.auth.uid
                      || soloAnadePropioMiembro(teamId, request.auth.uid)
                    )
                    && request.resource.data.captainId == resource.data.captainId
                    && request.resource.data.members.size() >= 1
                    && request.resource.data.members.size() <= 23;

      allow delete: if false;
    }

    match /challenges/{challengeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isPayloadSizeValid() && request.resource.data.creatorId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.creatorId == request.auth.uid;
    }

    match /matches/{matchId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isPayloadSizeValid() 
                    && (request.resource.data.localCaptainId == request.auth.uid || request.resource.data.visitorCaptainId == request.auth.uid);
      allow update: if isSignedIn() 
                    && (resource.data.localCaptainId == request.auth.uid || resource.data.visitorCaptainId == request.auth.uid)
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['playerStats', 'matchConfirmedAt']); 
      allow delete: if false;
    }

    match /reviews/{reviewId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && isPayloadSizeValid()
                    && request.resource.data.reviewerUserId == request.auth.uid
                    && reviewId == request.resource.data.matchId + '_' + request.auth.uid
                    && get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data.status == 'confirmed';
      allow update, delete: if false; 
    }

    match /system_metrics/{docId} {
      allow read, write: if isSuperadmin();
    }
  }
}
